#!/usr/bin/env python3
"""
generate_responsive_images.py

מייצר גרסאות בגדלים שונים (ו-WebP) לכל אחת מהתמונות הגדולות של האתר,
כדי שטלפון לא יוריד את אותו קובץ ענק שמחשב שולחני מוריד.

שימוש:
    pip install Pillow
    python generate_responsive_images.py

מריצים את זה מתוך תיקיית הפרויקט, כשהתמונות המקוריות (yamin.jpg,
yamin-hey.jpg, yamin-champ.jpg) נמצאות בתיקיית השורש. הפלט ייכנס
לתיקייה images/ עם שמות כמו yamin-800.webp, yamin-1600.webp וכו'.
"""

from pathlib import Path
from PIL import Image

SOURCE_IMAGES = ["yamin.jpg", "yamin-hey.jpg", "yamin-champ.jpg"]
WIDTHS = [640, 960, 1600, 2400]  # טלפון, טלפון גדול/טאבלט, מחשב, מסך רחב
OUTPUT_DIR = Path("images")
QUALITY = 82


def process_image(path: Path) -> None:
    if not path.exists():
        print(f"⏭  דילוג: {path} לא נמצא בתיקייה הזו.")
        return

    stem = path.stem
    with Image.open(path) as img:
        img = img.convert("RGB")
        original_width, original_height = img.size

        for width in WIDTHS:
            if width > original_width:
                continue  # אין טעם להגדיל תמונה מעבר לגודל המקורי

            height = round(original_height * (width / original_width))
            resized = img.resize((width, height), Image.LANCZOS)

            out_path = OUTPUT_DIR / f"{stem}-{width}.webp"
            resized.save(out_path, "WEBP", quality=QUALITY, method=6)
            print(f"✅ {out_path} ({width}x{height})")


def main() -> None:
    OUTPUT_DIR.mkdir(exist_ok=True)
    for name in SOURCE_IMAGES:
        process_image(Path(name))

    print("\nסיימתי. עכשיו אפשר להשתמש ב-CSS עם image-set(), לדוגמה:")
    print(
        """
.hero-image {
  background-image: image-set(
    url("images/yamin-640.webp") 1x,
    url("images/yamin-1600.webp") 2x
  );
}

@media (min-width: 1400px) {
  .hero-image {
    background-image: image-set(
      url("images/yamin-1600.webp") 1x,
      url("images/yamin-2400.webp") 2x
    );
  }
}
"""
    )


if __name__ == "__main__":
    main()